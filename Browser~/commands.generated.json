{
  "schema_version": 1,
  "transport_id": "web-viewer",
  "default_scenario_id": "",
  "scenarios": [
    {
      "id": "initialize",
      "label": "Initialize viewer",
      "command": "initialize_viewer",
      "payload": {
        "revision": "$revision"
      },
      "run_automatically": true,
      "expected_success": true
    },
    {
      "id": "select-red",
      "label": "Select red",
      "command": "select_elements",
      "payload": {
        "revision": "$revision",
        "element_ids": [
          "red"
        ]
      },
      "run_automatically": true,
      "expected_success": true
    },
    {
      "id": "select-green-blue",
      "label": "Select green and blue",
      "command": "select_elements",
      "payload": {
        "revision": "$revision",
        "element_ids": [
          "green",
          "blue"
        ]
      },
      "run_automatically": true,
      "expected_success": true
    },
    {
      "id": "clear-selection",
      "label": "Clear selection",
      "command": "clear_selection",
      "payload": {
        "revision": "$revision"
      },
      "run_automatically": true,
      "expected_success": true
    },
    {
      "id": "invalid-selection",
      "label": "Reject unknown element",
      "command": "select_elements",
      "payload": {
        "revision": "$revision",
        "element_ids": [
          "missing"
        ]
      },
      "run_automatically": true,
      "expected_success": false
    },
    {
      "id": "stale-selection",
      "label": "Reject stale revision",
      "command": "select_elements",
      "payload": {
        "revision": "$stale_revision",
        "element_ids": [
          "blue"
        ]
      },
      "run_automatically": true,
      "expected_success": false
    },
    {
      "id": "navigation-home",
      "label": "Return camera to origin",
